<template id="toggle-switch-template">
	<style>
		.toggle_button {
			--tgl-w-c1: 100%;
			--tgl-w: calc(var(--tgl-w-c1) / 2);
			--tgl-h: var(--tgl-w-c1);
			--tgl-mv: 50%;
			--tgl-r: 999em;

			position: relative;
			width: var(--tgl-w-c1);
			height: var(--tgl-h);
			margin: auto;
		}

		.toggle_input {
			position: absolute;
			width: var(--tgl-w-c1);
			height: var(--tgl-h);
			opacity: 0;
			cursor: pointer;
		}

		.toggle_input:checked+.toggle_label {
			background-color: #4BD865;
		}

		.toggle_input:checked+.toggle_label::after {
			left: var(--tgl-mv);
		}

		.toggle_label {
			aspect-ratio: 2/1;
			width: auto;
			height: var(--tgl-h);
			background-color: #ccc;
			border-radius: var(--tgl-r);
			display: inline-block;
			transition: background-color 0.5s;
			position: relative;
		}

		.toggle_label::after {
			content: "";
			aspect-ratio: 1/1;
			position: absolute;
			width: auto;
			height: 100%;
			background-color: #fff;
			border-radius: var(--tgl-r);
			top: 0;
			left: 0;
			transition: left 0.4s;
		}
	</style>
	<label class="toggle_button">
		<input class="toggle_input" type="checkbox" />
		<span class="toggle_label"></span>
	</label>
</template>
				"focus": true,
				"panel": "shared"
			}
		},
		{
			"label": "run YAJU",
			"type": "shell",
			"command": "~/public_html/yjlang/compileAndExecuteYAJU.sh",
			"args": [
				"${file}"
			],
			"group": {
				"kind": "build",

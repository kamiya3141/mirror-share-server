{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "run C",
			"type": "shell",
			"command": "~/public_html/clang/compileAndExecuteC.sh",
			"args": [
				"${fileDirname}/${fileBasenameNoExtension}"
			],
			"group": {
				"kind": "build",
				"isDefault": false
			},
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": true,
				"panel": "shared"
			}
		},
		{
			"label": "debug C",
			"type": "shell",
			"command": "~/public_html/clang/compileAndDebugC.sh",
			"args": [
				"${fileDirname}/${fileBasenameNoExtension}"
			],
			"group": {
				"kind": "build",
